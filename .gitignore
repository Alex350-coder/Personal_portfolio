# Only the app goes into the repository: client/, server/ and .github/.
# Everything else at the root (planning docs, .claude/, docs/, ...) stays local.
/*
!/.gitignore
!/client/
!/server/
!/.github/

# Dependencies and build output
node_modules/
dist/
coverage/
playwright-report/
test-results/

# Environment and secrets
.env
.env.*
!.env.example

# Logs and OS noise
*.log
.DS_Store
Thumbs.db

# The track-new-files hook writes .claude/ relative to the cwd; only the root copy is meaningful (local).
client/**/.claude/
server/**/.claude/
